---
source: src/generate/mod.rs
expression: result.content
---
{
  description = "A sample Python application";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    poetry2nix.url = "github:nix-community/poetry2nix";
    
  };

  outputs = { self, nixpkgs, flake-utils, poetry2nix,  }:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
        poetry2nix = poetry2nix.lib.mkPoetry2Nix { inherit pkgs; };
        pythonApp = poetry2nix.mkPoetryApplication {
          projectDir = ./.;
        };
        
      in
      {
        checks = {
          python-lint = pkgs.runCommand "python-lint" {
            nativeBuildInputs = [ pkgs.ruff ];
          } ''
            cd ${./.}
            ruff check .
            touch $out
          '';

          python-typecheck = pkgs.runCommand "python-typecheck" {
            nativeBuildInputs = [ pkgs.mypy ];
          } ''
            cd ${./.}
            mypy .
            touch $out
          '';
          
        };

        packages.default = pythonApp;

        devShells.default = pkgs.mkShell {
          packages = with pkgs; [
            python3
            poetry
            ruff
            mypy
            
          ];

          inputsFrom = [ pythonApp ];

        };
      });
}
